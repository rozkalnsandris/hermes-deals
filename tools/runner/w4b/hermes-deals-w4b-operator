#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

TARGET_SHA='128325461f249791af8a5653163772e955dd2b89'
TARGET_SHORT="${TARGET_SHA:0:12}"
PRIMARY='/home/andris/hermes-deals'
ROOT="/usr/local/libexec/hermes-deals-w4b/$TARGET_SHA"
SOURCE="$ROOT/source"
COMPOSE_BASE="$SOURCE/docker-compose.yml"
COMPOSE_PRODUCTION="$SOURCE/docker-compose.production.yml"
NGINX_TARGET="$SOURCE/infra/nginx.conf"
OVERRIDE="$ROOT/docker-compose.w4b.yml"
TARGET_IMAGE="hermes-deals-api:w4b-$TARGET_SHORT"
STATE_DIR='/var/lib/hermes-deals-w4b'
ROLLBACK_STATE="$STATE_DIR/rollback.json"
LOCK='/run/lock/hermes-deals-w4b.lock'

fail() {
  printf 'W4B_RESULT=BLOCKED\n'
  printf 'W4B_REASON=%s\n' "$1"
  printf 'PRODUCTION_MUTATED=%s\n' "${PRODUCTION_MUTATED:-false}"
  exit 1
}

[[ ${EUID:-$(id -u)} -eq 0 ]] || fail 'operator_must_run_as_root'
[[ $# -eq 1 ]] || fail 'invalid_argument_count'
MODE="$1"
[[ "$MODE" =~ ^(preflight|cutover|verify|rollback)$ ]] || fail 'invalid_mode'

for command in curl docker flock grep install python3 sha256sum stat systemctl; do
  command -v "$command" >/dev/null 2>&1 || fail "missing_command_${command}"
done
for path in "$PRIMARY" "$SOURCE"; do
  [[ -d "$path" && ! -L "$path" ]] || fail 'required_directory_missing_or_unsafe'
done
for path in "$COMPOSE_BASE" "$COMPOSE_PRODUCTION" "$NGINX_TARGET" "$OVERRIDE"; do
  [[ -f "$path" && ! -L "$path" ]] || fail 'required_runtime_file_missing_or_unsafe'
done
[[ "$(stat -c '%U:%G' "$ROOT")" == 'root:root' ]] || fail 'runtime_root_ownership_invalid'

exec 9>"$LOCK"
flock -n 9 || fail 'another_w4b_operation_is_active'

COMPOSE=(
  docker compose
  --project-directory "$PRIMARY"
  --env-file "$PRIMARY/.env"
  -f "$COMPOSE_BASE"
  -f "$COMPOSE_PRODUCTION"
  -f "$OVERRIDE"
)

compose() {
  local api_tag="$1"
  local ui_mode="$2"
  local nginx_config="$3"
  shift 3
  env \
    DEALS_BIND_IP='127.0.0.1' \
    DEALS_HTTP_PORT='9128' \
    HERMES_DEALS_API_TAG="$api_tag" \
    HERMES_UI_ASSET_MODE="$ui_mode" \
    W4B_NGINX_CONFIG="$nginx_config" \
    "${COMPOSE[@]}" "$@"
}

sha_text() {
  printf '%s' "$1" | sha256sum | awk '{print $1}'
}

primary_state() {
  printf '%s\n' \
    "$(git -C "$PRIMARY" rev-parse HEAD)" \
    "$(git -C "$PRIMARY" branch --show-current)" \
    "$(git -C "$PRIMARY" status --porcelain=v1 --untracked-files=all)" \
    "$(git -C "$PRIMARY" diff --cached --binary)" |
    sha256sum | awk '{print $1}'
}

read_live_alembic() {
  local db_container db_user db_name
  local -a fields
  db_container="$(docker ps --filter 'label=com.docker.compose.project=hermes-deals' --filter 'label=com.docker.compose.service=db' --format '{{.ID}}')"
  [[ -n "$db_container" ]] || return 1
  mapfile -d '' -t fields < <(docker inspect "$db_container" | python3 -c '
import json, sys
rows = json.load(sys.stdin)
if len(rows) != 1:
    raise SystemExit(2)
env = {}
for item in rows[0].get("Config", {}).get("Env", []):
    key, sep, value = item.partition("=")
    if sep:
        env[key] = value
for key in ("POSTGRES_USER", "POSTGRES_DB"):
    value = env.get(key, "")
    if not value or "\x00" in value:
        raise SystemExit(2)
    sys.stdout.write(value + "\x00")
')
  [[ ${#fields[@]} -eq 2 ]] || return 1
  db_user="${fields[0]}"
  db_name="${fields[1]}"
  docker exec "$db_container" psql -X -v ON_ERROR_STOP=1 -U "$db_user" -d "$db_name" -Atqc \
    'SELECT version_num FROM alembic_version;'
}

service_container() {
  local service="$1"
  docker ps \
    --filter 'label=com.docker.compose.project=hermes-deals' \
    --filter "label=com.docker.compose.service=$service" \
    --format '{{.ID}}'
}

resolve_web_base() {
  local container="$1"
  docker inspect "$container" | python3 -c '
import json, sys
rows = json.load(sys.stdin)
if len(rows) != 1:
    raise SystemExit(2)
bindings = rows[0].get("NetworkSettings", {}).get("Ports", {}).get("80/tcp")
if not isinstance(bindings, list) or len(bindings) != 1:
    raise SystemExit(2)
row = bindings[0]
if row.get("HostIp") != "127.0.0.1" or row.get("HostPort") != "9128":
    raise SystemExit(2)
print("http://127.0.0.1:9128")
'
}

resolve_nginx_mount() {
  local container="$1"
  docker inspect "$container" | python3 -c '
import json, os, sys
rows = json.load(sys.stdin)
if len(rows) != 1:
    raise SystemExit(2)
matches = [
    row for row in rows[0].get("Mounts", [])
    if row.get("Destination") == "/etc/nginx/conf.d/default.conf"
]
if len(matches) != 1 or matches[0].get("Type") != "bind":
    raise SystemExit(2)
source = str(matches[0].get("Source") or "")
if not source.startswith("/") or not os.path.isfile(source) or os.path.islink(source):
    raise SystemExit(2)
print(source)
'
}

cloudflared_pid() {
  local pid
  pid="$(systemctl show -p MainPID --value cloudflared.service 2>/dev/null || true)"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "$pid"
}

assert_target_source_contract() {
  python3 - "$PRIMARY/docker-compose.yml" "$COMPOSE_BASE" "$COMPOSE_PRODUCTION" "$PRIMARY/docker-compose.production.yml" "$NGINX_TARGET" <<'PY'
from pathlib import Path
import sys

primary_base, target_base, target_prod, primary_prod, nginx = map(Path, sys.argv[1:])
for path in (primary_base, target_base, target_prod, primary_prod, nginx):
    if not path.is_file() or path.is_symlink():
        raise SystemExit(2)

primary = primary_base.read_text(encoding="utf-8").splitlines()
target = target_base.read_text(encoding="utf-8").splitlines()
mode_lines = [line for line in target if "HERMES_UI_ASSET_MODE:" in line]
if mode_lines != ["      HERMES_UI_ASSET_MODE: ${HERMES_UI_ASSET_MODE:-inline-w3}"]:
    raise SystemExit("unexpected W4B Compose mode line")
target_without_mode = [line for line in target if "HERMES_UI_ASSET_MODE:" not in line]
if target_without_mode != primary:
    raise SystemExit("target base Compose differs from production baseline beyond W4B mode")
if target_prod.read_bytes() != primary_prod.read_bytes():
    raise SystemExit("production Compose overlay drift")
nginx_text = nginx.read_text(encoding="utf-8")
if nginx_text.count("location ^~ /ui/assets/") != 1:
    raise SystemExit("target nginx hashed-asset location mismatch")
block = nginx_text.split("location ^~ /ui/assets/", 1)[1].split("}", 1)[0]
if "proxy_pass http://api:8000;" not in block:
    raise SystemExit("target nginx hashed-asset proxy missing")
if "immutable" in block.casefold() or "max-age" in block.casefold():
    raise SystemExit("W4C cache policy leaked into W4B")
PY
}

validate_compose_model() {
  local api_tag="$1"
  local ui_mode="$2"
  local nginx_config="$3"
  compose "$api_tag" "$ui_mode" "$nginx_config" config --format json |
    python3 - "$api_tag" "$ui_mode" "$nginx_config" <<'PY'
import json, os, sys
expected_tag, expected_mode, expected_nginx = sys.argv[1:]
data = json.load(sys.stdin)
services = data.get("services") or {}
api = services.get("api") or {}
web = services.get("web") or {}
db = services.get("db") or {}
if api.get("image") != f"hermes-deals-api:{expected_tag}":
    raise SystemExit("API image mismatch")
env = api.get("environment") or {}
if env.get("HERMES_UI_ASSET_MODE") != expected_mode:
    raise SystemExit("UI asset mode mismatch")
ports = web.get("ports") or []
if len(ports) != 1:
    raise SystemExit("web port count mismatch")
port = ports[0]
if str(port.get("host_ip")) != "127.0.0.1" or str(port.get("published")) != "9128" or str(port.get("target")) != "80":
    raise SystemExit("web loopback port mismatch")
mounts = web.get("volumes") or []
nginx = [row for row in mounts if row.get("target") == "/etc/nginx/conf.d/default.conf"]
if len(nginx) != 1 or nginx[0].get("type") != "bind":
    raise SystemExit("nginx mount count/type mismatch")
if os.path.realpath(str(nginx[0].get("source") or "")) != os.path.realpath(expected_nginx):
    raise SystemExit("nginx mount source mismatch")
if not db:
    raise SystemExit("database service missing from model")
PY
}

capture_baseline() {
  API_BEFORE="$(service_container api)"
  WEB_BEFORE="$(service_container web)"
  DB_BEFORE="$(service_container db)"
  [[ -n "$API_BEFORE" && -n "$WEB_BEFORE" && -n "$DB_BEFORE" ]] || fail 'production_containers_missing'
  WEB_BASE="$(resolve_web_base "$WEB_BEFORE")" || fail 'web_is_not_loopback_only'
  OLD_NGINX_SOURCE="$(resolve_nginx_mount "$WEB_BEFORE")" || fail 'current_nginx_mount_invalid'
  API_IMAGE_TAG="$(docker inspect "$API_BEFORE" --format '{{.Config.Image}}')"
  API_IMAGE_ID="$(docker inspect "$API_BEFORE" --format '{{.Image}}')"
  API_REVISION="$(docker inspect "$API_BEFORE" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
  WEB_IMAGE_ID="$(docker inspect "$WEB_BEFORE" --format '{{.Image}}')"
  [[ "$API_IMAGE_TAG" == hermes-deals-api:release-* ]] || fail 'current_api_tag_not_release_managed'
  [[ "$API_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] || fail 'current_api_image_id_invalid'
  [[ "$API_REVISION" =~ ^[0-9a-f]{40}$ ]] || fail 'current_api_revision_invalid'
  [[ "$WEB_IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] || fail 'current_web_image_id_invalid'
  ALEMBIC_BEFORE="$(read_live_alembic)" || fail 'alembic_read_failed'
  [[ "$ALEMBIC_BEFORE" =~ ^[0-9A-Za-z_.-]+$ ]] || fail 'alembic_revision_invalid'
  CLOUDFLARED_BEFORE="$(cloudflared_pid)" || fail 'cloudflared_not_active'
  GIT_BEFORE="$(primary_state)"
}

assert_inline_w3() {
  local base="$1"
  local body headers
  body="$(mktemp)"
  headers="$(mktemp)"
  trap 'rm -f "$body" "$headers"' RETURN
  curl --fail --silent --show-error --max-time 8 -D "$headers" "$base/ui" -o "$body" || return 1
  grep -Fq 'data-hermes-production-bundle="app.js"' "$body" || return 1
  grep -Fq 'w3-behavior-preserving-bootstrap-v1' "$body" || return 1
  if grep -Fq 'hermes-w4-shadow' "$body"; then
    return 1
  fi
}

assert_hashed_w4() {
  local base="$1"
  local body headers js_path css_path js_headers css_headers js_body css_body
  body="$(mktemp)"; headers="$(mktemp)"; js_headers="$(mktemp)"; css_headers="$(mktemp)"; js_body="$(mktemp)"; css_body="$(mktemp)"
  trap 'rm -f "$body" "$headers" "$js_headers" "$css_headers" "$js_body" "$css_body"' RETURN
  curl --fail --silent --show-error --max-time 8 -D "$headers" "$base/ui" -o "$body" || return 1
  grep -Fiq '^X-Hermes-UI-Asset-Mode: hashed-w4' "$headers" || return 1
  grep -Fiq '^Cache-Control: no-store' "$headers" || return 1
  grep -Fq '<meta name="hermes-w4-shadow" content="hashed-assets-v1">' "$body" || return 1
  ! grep -Fq 'data-hermes-production-bundle=' "$body" || return 1
  ! grep -Fq '/ui/app.js' "$body" || return 1
  ! grep -Fq '/ui/styles.css' "$body" || return 1
  js_path="$(grep -oE '/ui/assets/[A-Za-z0-9_-]+\.[A-Za-z0-9_-]{8,}\.js' "$body" | sort -u)"
  css_path="$(grep -oE '/ui/assets/[A-Za-z0-9_-]+\.[A-Za-z0-9_-]{8,}\.css' "$body" | sort -u)"
  [[ -n "$js_path" && -n "$css_path" ]] || return 1
  [[ "$(printf '%s\n' "$js_path" | wc -l)" -eq 1 ]] || return 1
  [[ "$(printf '%s\n' "$css_path" | wc -l)" -eq 1 ]] || return 1
  curl --fail --silent --show-error --max-time 8 -D "$js_headers" "$base$js_path" -o "$js_body" || return 1
  curl --fail --silent --show-error --max-time 8 -D "$css_headers" "$base$css_path" -o "$css_body" || return 1
  grep -Fiq '^Content-Type: application/javascript' "$js_headers" || return 1
  grep -Fiq '^Content-Type: text/css' "$css_headers" || return 1
  grep -Fiq '^Cache-Control: no-store' "$js_headers" || return 1
  grep -Fiq '^Cache-Control: no-store' "$css_headers" || return 1
  grep -Fq 'w3-behavior-preserving-bootstrap-v1' "$js_body" || return 1
  grep -Fq 'HERMES_UI_STYLE_OPEN:' "$css_body" || return 1
  [[ "$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "$base/ui/assets/not-in-package.js")" == 404 ]] || return 1
  [[ "$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 5 "$base/ui/assets/w4-shadow-package.json")" == 404 ]] || return 1
  [[ "$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 8 "$base/ui/review")" == 200 ]] || return 1
  curl --fail --silent --show-error --max-time 8 "$base/api/health" | grep -Fq '"status":"ok"' || return 1
}

assert_target_runtime() {
  local api web db web_base nginx_mount mode_env revision
  api="$(service_container api)"; web="$(service_container web)"; db="$(service_container db)"
  [[ -n "$api" && -n "$web" && -n "$db" ]] || return 1
  [[ "$(docker inspect "$api" --format '{{.Image}}')" == "$(docker image inspect "$TARGET_IMAGE" --format '{{.Id}}')" ]] || return 1
  revision="$(docker inspect "$api" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
  [[ "$revision" == "$TARGET_SHA" ]] || return 1
  mode_env="$(docker inspect "$api" | python3 -c '
import json, sys
rows=json.load(sys.stdin)
values=[]
for item in rows[0].get("Config",{}).get("Env",[]):
    if item.startswith("HERMES_UI_ASSET_MODE="):
        values.append(item.split("=",1)[1])
if values != ["hashed-w4"]:
    raise SystemExit(2)
print(values[0])
')" || return 1
  [[ "$mode_env" == hashed-w4 ]] || return 1
  web_base="$(resolve_web_base "$web")" || return 1
  nginx_mount="$(resolve_nginx_mount "$web")" || return 1
  [[ "$(readlink -f -- "$nginx_mount")" == "$(readlink -f -- "$NGINX_TARGET")" ]] || return 1
  assert_hashed_w4 "$web_base"
}

assert_target_api_transition() {
  local api api_image expected_image revision
  local -a mode_rows
  api="$(service_container api)"
  [[ -n "$api" ]] || return 1
  api_image="$(docker inspect "$api" --format '{{.Image}}')" || return 1
  expected_image="$(docker image inspect "$TARGET_IMAGE" --format '{{.Id}}')" || return 1
  [[ "$api_image" == "$expected_image" ]] || return 1
  revision="$(docker inspect "$api" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" || return 1
  if [[ "$revision" != "$TARGET_SHA" ]]; then
    return 1
  fi
  mapfile -t mode_rows < <(
    docker inspect "$api" --format '{{range .Config.Env}}{{println .}}{{end}}' |
      grep '^HERMES_UI_ASSET_MODE='
  )
  [[ ${#mode_rows[@]} -eq 1 ]] || return 1
  [[ "${mode_rows[0]}" == 'HERMES_UI_ASSET_MODE=hashed-w4' ]] || return 1
}

write_rollback_state() {
  install -d -o root -g root -m 0700 "$STATE_DIR"
  local tmp
  tmp="$(mktemp "$STATE_DIR/.rollback.XXXXXX")"
  python3 - "$tmp" "$TARGET_SHA" "$API_IMAGE_TAG" "$API_IMAGE_ID" "$API_REVISION" "$WEB_IMAGE_ID" "$OLD_NGINX_SOURCE" "$DB_BEFORE" "$ALEMBIC_BEFORE" "$GIT_BEFORE" "$CLOUDFLARED_BEFORE" <<'PY'
import json, pathlib, sys
(
 path, target_sha, api_tag, api_id, api_revision, web_image_id, nginx_source,
 db_id, alembic, git_state, cloudflared_pid,
) = sys.argv[1:]
pathlib.Path(path).write_text(json.dumps({
 "schema_version": 1,
 "target_sha": target_sha,
 "api_tag": api_tag,
 "api_image_id": api_id,
 "api_revision": api_revision,
 "web_image_id": web_image_id,
 "nginx_source": nginx_source,
 "db_container": db_id,
 "alembic_revision": alembic,
 "production_git_state": git_state,
 "cloudflared_pid": int(cloudflared_pid),
}, sort_keys=True, indent=2) + "\n", encoding="utf-8")
PY
  chown root:root "$tmp"
  chmod 0600 "$tmp"
  mv -f -- "$tmp" "$ROLLBACK_STATE"
}

load_rollback_state() {
  [[ -f "$ROLLBACK_STATE" && ! -L "$ROLLBACK_STATE" ]] || fail 'rollback_state_missing'
  [[ "$(stat -c '%U:%G:%a' "$ROLLBACK_STATE")" == 'root:root:600' ]] || fail 'rollback_state_metadata_invalid'
  mapfile -d '' -t ROLLBACK_FIELDS < <(python3 - "$ROLLBACK_STATE" "$TARGET_SHA" <<'PY'
import json, os, pathlib, re, sys
path=pathlib.Path(sys.argv[1]); target=sys.argv[2]
data=json.loads(path.read_text(encoding="utf-8"))
if data.get("schema_version") != 1 or data.get("target_sha") != target:
    raise SystemExit(2)
values=[
 str(data.get("api_tag") or ""), str(data.get("api_image_id") or ""),
 str(data.get("api_revision") or ""), str(data.get("web_image_id") or ""),
 str(data.get("nginx_source") or ""), str(data.get("db_container") or ""),
 str(data.get("alembic_revision") or ""), str(data.get("production_git_state") or ""),
 str(data.get("cloudflared_pid") or ""),
]
if not values[0].startswith("hermes-deals-api:release-"):
    raise SystemExit(2)
for idx in (1,3):
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", values[idx]):
        raise SystemExit(2)
if not re.fullmatch(r"[0-9a-f]{40}", values[2]):
    raise SystemExit(2)
if not values[4].startswith("/") or not os.path.isfile(values[4]) or os.path.islink(values[4]):
    raise SystemExit(2)
if not re.fullmatch(r"[0-9a-f]{64}", values[7]):
    raise SystemExit(2)
if not values[8].isdigit() or int(values[8]) <= 0:
    raise SystemExit(2)
for value in values:
    if "\x00" in value:
        raise SystemExit(2)
    sys.stdout.write(value + "\x00")
PY
  )
  [[ ${#ROLLBACK_FIELDS[@]} -eq 9 ]] || fail 'rollback_state_field_count_invalid'
}

rollback_internal() {
  load_rollback_state
  local old_tag old_id old_revision old_web_image old_nginx old_db old_alembic old_git old_cloudflared
  local api web db base
  local -a mode_rows
  old_tag="${ROLLBACK_FIELDS[0]}"; old_id="${ROLLBACK_FIELDS[1]}"; old_revision="${ROLLBACK_FIELDS[2]}"
  old_web_image="${ROLLBACK_FIELDS[3]}"; old_nginx="${ROLLBACK_FIELDS[4]}"; old_db="${ROLLBACK_FIELDS[5]}"
  old_alembic="${ROLLBACK_FIELDS[6]}"; old_git="${ROLLBACK_FIELDS[7]}"; old_cloudflared="${ROLLBACK_FIELDS[8]}"
  [[ "$(docker image inspect "$old_tag" --format '{{.Id}}')" == "$old_id" ]] || return 1

  compose "${old_tag#hermes-deals-api:}" inline-w3 "$old_nginx" up -d --no-deps --no-build --wait api >/dev/null 2>&1 || return 1
  api="$(service_container api)"
  [[ -n "$api" ]] || return 1
  [[ "$(docker inspect "$api" --format '{{.Image}}')" == "$old_id" ]] || return 1
  [[ "$(docker inspect "$api" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" == "$old_revision" ]] || return 1
  mapfile -t mode_rows < <(
    docker inspect "$api" --format '{{range .Config.Env}}{{println .}}{{end}}' |
      grep '^HERMES_UI_ASSET_MODE='
  )
  [[ ${#mode_rows[@]} -eq 1 ]] || return 1
  [[ "${mode_rows[0]}" == 'HERMES_UI_ASSET_MODE=inline-w3' ]] || return 1

  compose "${old_tag#hermes-deals-api:}" inline-w3 "$old_nginx" up -d --no-deps --no-build --wait --force-recreate web >/dev/null 2>&1 || return 1
  web="$(service_container web)"; db="$(service_container db)"
  [[ -n "$web" && -n "$db" && "$db" == "$old_db" ]] || return 1
  [[ "$(docker inspect "$web" --format '{{.Image}}')" == "$old_web_image" ]] || return 1
  [[ "$(resolve_nginx_mount "$web")" == "$old_nginx" ]] || return 1
  base="$(resolve_web_base "$web")" || return 1
  assert_inline_w3 "$base" || return 1
  [[ "$(read_live_alembic)" == "$old_alembic" ]] || return 1
  [[ "$(primary_state)" == "$old_git" ]] || return 1
  [[ "$(cloudflared_pid)" == "$old_cloudflared" ]] || return 1
  return 0
}

preflight() {
  PRODUCTION_MUTATED=false
  assert_target_source_contract || fail 'target_source_contract_mismatch'
  capture_baseline
  assert_inline_w3 "$WEB_BASE" || fail 'production_not_inline_w3'
  validate_compose_model "${API_IMAGE_TAG#hermes-deals-api:}" inline-w3 "$OLD_NGINX_SOURCE" || fail 'rollback_compose_model_invalid'
  validate_compose_model "w4b-$TARGET_SHORT" hashed-w4 "$NGINX_TARGET" || fail 'target_compose_model_invalid'
  [[ "$(primary_state)" == "$GIT_BEFORE" ]] || fail 'production_git_changed_during_preflight'
  [[ "$(read_live_alembic)" == "$ALEMBIC_BEFORE" ]] || fail 'database_revision_changed_during_preflight'
  [[ "$(cloudflared_pid)" == "$CLOUDFLARED_BEFORE" ]] || fail 'cloudflared_changed_during_preflight'
  printf 'W4B_RESULT=PASS\n'
  printf 'W4B_MODE=preflight\n'
  printf 'UI_STATE=INLINE_W3\n'
  printf 'TARGET_SOURCE_READY=true\n'
  printf 'LOOPBACK_BIND=PASS\n'
  printf 'DATABASE_UNCHANGED=true\n'
  printf 'PRODUCTION_GIT_UNCHANGED=true\n'
  printf 'CLOUDFLARED_STABLE=true\n'
  printf 'PRODUCTION_MUTATED=false\n'
  printf 'NEXT_ACTION=cutover\n'
}

cutover() {
  PRODUCTION_MUTATED=false
  assert_target_source_contract || fail 'target_source_contract_mismatch'
  capture_baseline
  assert_inline_w3 "$WEB_BASE" || fail 'production_not_inline_w3'
  validate_compose_model "${API_IMAGE_TAG#hermes-deals-api:}" inline-w3 "$OLD_NGINX_SOURCE" || fail 'rollback_compose_model_invalid'
  validate_compose_model "w4b-$TARGET_SHORT" hashed-w4 "$NGINX_TARGET" || fail 'target_compose_model_invalid'
  write_rollback_state

  docker build \
    --pull=false \
    --label "org.opencontainers.image.revision=$TARGET_SHA" \
    --label 'org.opencontainers.image.source=https://github.com/rozkalnsandris/hermes-deals' \
    --tag "$TARGET_IMAGE" \
    "$SOURCE/backend" >/dev/null
  [[ "$(docker image inspect "$TARGET_IMAGE" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')" == "$TARGET_SHA" ]] \
    || fail 'target_image_revision_mismatch'
  docker run --rm --entrypoint /bin/sh "$TARGET_IMAGE" -eu -c 'test ! -e /usr/local/bin/node && test ! -e /usr/local/bin/npm && test -s /app/app/ui_w4_shadow/w4-shadow-package.json' \
    || fail 'target_image_package_smoke_failed'

  set +e
  : > /tmp/hermes-deals-w4b-compose.log
  compose "w4b-$TARGET_SHORT" hashed-w4 "$NGINX_TARGET" up -d --no-deps --no-build --wait api >/tmp/hermes-deals-w4b-compose.log 2>&1
  APPLY_RC=$?
  if (( APPLY_RC == 0 )) && ! assert_target_api_transition; then
    APPLY_RC=1
  fi
  if (( APPLY_RC == 0 )); then
    compose "w4b-$TARGET_SHORT" hashed-w4 "$NGINX_TARGET" up -d --no-deps --no-build --wait --force-recreate web >>/tmp/hermes-deals-w4b-compose.log 2>&1
    APPLY_RC=$?
  fi
  set -e
  PRODUCTION_MUTATED=true

  if (( APPLY_RC == 0 )) && \
     [[ "$(service_container db)" == "$DB_BEFORE" ]] && \
     [[ "$(docker inspect "$(service_container web)" --format '{{.Image}}')" == "$WEB_IMAGE_ID" ]] && \
     [[ "$(read_live_alembic)" == "$ALEMBIC_BEFORE" ]] && \
     [[ "$(primary_state)" == "$GIT_BEFORE" ]] && \
     [[ "$(cloudflared_pid)" == "$CLOUDFLARED_BEFORE" ]] && \
     assert_target_runtime; then
    rm -f /tmp/hermes-deals-w4b-compose.log
    printf 'W4B_RESULT=PASS\n'
    printf 'W4B_MODE=cutover\n'
    printf 'UI_STATE=HASHED_W4\n'
    printf 'HASHED_ASSETS=PASS\n'
    printf 'LOOPBACK_BIND=PASS\n'
    printf 'DATABASE_UNCHANGED=true\n'
    printf 'PRODUCTION_GIT_UNCHANGED=true\n'
    printf 'CLOUDFLARED_STABLE=true\n'
    printf 'ROLLBACK_AVAILABLE=true\n'
    printf 'AUTO_ROLLBACK=not_needed\n'
    printf 'PRODUCTION_MUTATED=true\n'
    printf 'NEXT_ACTION=verify\n'
    return 0
  fi

  rm -f /tmp/hermes-deals-w4b-compose.log
  if rollback_internal; then
    printf 'W4B_RESULT=BLOCKED\n'
    printf 'W4B_REASON=cutover_validation_failed_auto_rollback_passed\n'
    printf 'UI_STATE=INLINE_W3\n'
    printf 'ROLLBACK_AVAILABLE=true\n'
    printf 'AUTO_ROLLBACK=PASS\n'
    printf 'PRODUCTION_MUTATED=true\n'
    exit 1
  fi
  printf 'W4B_RESULT=FAIL\n'
  printf 'W4B_REASON=cutover_validation_failed_auto_rollback_failed\n'
  printf 'AUTO_ROLLBACK=FAIL\n'
  printf 'PRODUCTION_MUTATED=true\n'
  exit 2
}

verify() {
  PRODUCTION_MUTATED=false
  local git_before db_before alembic_before cloud_before
  git_before="$(primary_state)"
  db_before="$(service_container db)"
  alembic_before="$(read_live_alembic)" || fail 'alembic_read_failed'
  cloud_before="$(cloudflared_pid)" || fail 'cloudflared_not_active'
  [[ -f "$ROLLBACK_STATE" && ! -L "$ROLLBACK_STATE" ]] || fail 'rollback_state_missing'
  assert_target_runtime || fail 'hashed_w4_runtime_verification_failed'
  [[ "$(service_container db)" == "$db_before" ]] || fail 'database_container_changed_during_verify'
  [[ "$(read_live_alembic)" == "$alembic_before" ]] || fail 'database_revision_changed_during_verify'
  [[ "$(primary_state)" == "$git_before" ]] || fail 'production_git_changed_during_verify'
  [[ "$(cloudflared_pid)" == "$cloud_before" ]] || fail 'cloudflared_changed_during_verify'
  printf 'W4B_RESULT=PASS\n'
  printf 'W4B_MODE=verify\n'
  printf 'UI_STATE=HASHED_W4\n'
  printf 'HASHED_ASSETS=PASS\n'
  printf 'LOOPBACK_BIND=PASS\n'
  printf 'DATABASE_UNCHANGED=true\n'
  printf 'PRODUCTION_GIT_UNCHANGED=true\n'
  printf 'CLOUDFLARED_STABLE=true\n'
  printf 'ROLLBACK_AVAILABLE=true\n'
  printf 'PRODUCTION_MUTATED=false\n'
  printf 'NEXT_ACTION=w4c\n'
}

case "$MODE" in
  preflight) preflight ;;
  cutover) cutover ;;
  verify) verify ;;
  rollback)
    PRODUCTION_MUTATED=true
    if rollback_internal; then
      printf 'W4B_RESULT=PASS\nW4B_MODE=rollback\nUI_STATE=INLINE_W3\nAUTO_ROLLBACK=manual_root_only\nPRODUCTION_MUTATED=true\n'
    else
      printf 'W4B_RESULT=FAIL\nW4B_MODE=rollback\nW4B_REASON=root_only_rollback_failed\nPRODUCTION_MUTATED=true\n'
      exit 2
    fi
    ;;
esac