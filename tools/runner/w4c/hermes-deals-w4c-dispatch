#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

ROOT='/usr/local/libexec/hermes-deals-w4c'
OPERATOR="$ROOT/hermes_deals_w4c_operator.py"
MANIFEST="$ROOT/control.sha256"

[[ ${EUID:-$(id -u)} -eq 0 ]] || {
  printf 'W4C_RESULT=BLOCKED\nW4C_REASON=dispatcher_must_run_as_root\nPRODUCTION_MUTATED=false\n'
  exit 1
}
[[ $# -eq 1 ]] || {
  printf 'W4C_RESULT=BLOCKED\nW4C_REASON=invalid_argument_count\nPRODUCTION_MUTATED=false\n'
  exit 1
}
MODE="$1"
[[ "$MODE" =~ ^(preflight|cutover|verify)$ ]] || {
  printf 'W4C_RESULT=BLOCKED\nW4C_REASON=runner_mode_not_authorized\nPRODUCTION_MUTATED=false\n'
  exit 1
}
[[ -d "$ROOT" && ! -L "$ROOT" ]] || {
  printf 'W4C_RESULT=BLOCKED\nW4C_REASON=control_root_missing_or_unsafe\nPRODUCTION_MUTATED=false\n'
  exit 1
}
[[ -f "$OPERATOR" && ! -L "$OPERATOR" && -f "$MANIFEST" && ! -L "$MANIFEST" ]] || {
  printf 'W4C_RESULT=BLOCKED\nW4C_REASON=control_file_missing_or_unsafe\nPRODUCTION_MUTATED=false\n'
  exit 1
}
[[ "$(stat -c '%U:%G:%a' "$ROOT")" == 'root:root:755' ]] || {
  printf 'W4C_RESULT=BLOCKED\nW4C_REASON=control_root_metadata_invalid\nPRODUCTION_MUTATED=false\n'
  exit 1
}
sha256sum --check --strict --quiet "$MANIFEST" || {
  printf 'W4C_RESULT=BLOCKED\nW4C_REASON=control_hash_mismatch\nPRODUCTION_MUTATED=false\n'
  exit 1
}
exec python3 "$OPERATOR" "$MODE"
