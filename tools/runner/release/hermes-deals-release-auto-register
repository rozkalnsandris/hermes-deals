#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

[[ ${EUID:-$(id -u)} -eq 0 ]] || fail "auto-register must run as root"
[[ $# -eq 3 ]] || fail "usage: hermes-deals-release-auto-register <sha> <pr-number> <audit-run-id-or-empty>"

NEW_SHA="$1"
PR_NUMBER="$2"
AUDIT_RUN_ID="$3"
REPOSITORY='rozkalnsandris/hermes-deals'
PRIMARY='/home/andris/hermes-deals'
SOURCE='/home/andris/hermes-deals-worktrees/release-control'
TOKEN_FILE='/etc/hermes-deals-release-bridge/token'
REGISTER='/usr/local/sbin/hermes-deals-release-register'
REGISTRY="/etc/hermes-deals-releases.d/api-ui-$NEW_SHA.json"
ROLLBACK_TMP=''

[[ "$NEW_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "invalid release SHA"
[[ "$PR_NUMBER" =~ ^[1-9][0-9]*$ ]] || fail "invalid PR number"
[[ -z "$AUDIT_RUN_ID" || "$AUDIT_RUN_ID" =~ ^[1-9][0-9]*$ ]] || fail "invalid audit run ID"

for command in chown chmod docker git gzip install mktemp python3 readlink rm runuser sha256sum stat; do
  command -v "$command" >/dev/null 2>&1 || fail "required command is missing: $command"
done
[[ -x "$REGISTER" && ! -L "$REGISTER" ]] || fail "registered release tool is missing or unsafe"
[[ -f "$TOKEN_FILE" && ! -L "$TOKEN_FILE" ]] || fail "bridge token is missing or unsafe"
[[ "$(stat -c '%U:%G:%a' "$TOKEN_FILE")" == 'root:root:600' ]] || fail "bridge token metadata is invalid"

if [[ -e "$REGISTRY" ]]; then
  [[ -f "$REGISTRY" && ! -L "$REGISTRY" ]] || fail "existing registry is unsafe"
  [[ "$(stat -c '%U:%G' "$REGISTRY")" == 'root:root' ]] || fail "existing registry ownership is invalid"
  python3 - "$REGISTRY" "$NEW_SHA" <<'PY'
import json
import pathlib
import sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
if data.get("schema_version") != 2:
    raise SystemExit("existing registry schema mismatch")
if data.get("release_class") != "api-ui":
    raise SystemExit("existing registry class mismatch")
if data.get("commit_sha") != sys.argv[2]:
    raise SystemExit("existing registry SHA mismatch")
if data.get("database_writes_authorized") is not False:
    raise SystemExit("existing registry unexpectedly authorizes database writes")
PY
  printf 'AUTO_REGISTER_RESULT=PASS\nREGISTRY_STATUS=already-present\nCOMMIT_SHA=%s\nDATABASE_WRITES_AUTHORIZED=false\n' "$NEW_SHA"
  exit 0
fi

[[ -d "$PRIMARY" && ! -L "$PRIMARY" ]] || fail "primary repository is missing or unsafe"
[[ -d "$SOURCE" && ! -L "$SOURCE" ]] || fail "release-control worktree is missing or unsafe"
[[ "$(stat -c '%U:%G' "$SOURCE")" == 'andris:andris' ]] || fail "release-control ownership is invalid"

runuser -u andris -- env HOME=/home/andris GIT_OPTIONAL_LOCKS=0 \
  git -C "$PRIMARY" fetch --prune origin main
[[ -z "$(runuser -u andris -- env HOME=/home/andris GIT_OPTIONAL_LOCKS=0 git -C "$SOURCE" status --porcelain=v1 --untracked-files=all)" ]] \
  || fail "release-control worktree is not clean"
runuser -u andris -- env HOME=/home/andris GIT_OPTIONAL_LOCKS=0 \
  git -C "$SOURCE" checkout --detach origin/main >/dev/null
[[ -z "$(runuser -u andris -- env HOME=/home/andris GIT_OPTIONAL_LOCKS=0 git -C "$SOURCE" branch --show-current)" ]] \
  || fail "release-control worktree is not detached"
[[ "$(runuser -u andris -- env HOME=/home/andris GIT_OPTIONAL_LOCKS=0 git -C "$SOURCE" rev-parse HEAD)" == "$NEW_SHA" ]] \
  || fail "release-control HEAD is not the requested SHA"
[[ "$(runuser -u andris -- env HOME=/home/andris GIT_OPTIONAL_LOCKS=0 git -C "$SOURCE" rev-parse refs/remotes/origin/main)" == "$NEW_SHA" ]] \
  || fail "release-control origin/main is not the requested SHA"

CI_RUN_ID="$(python3 - "$TOKEN_FILE" "$REPOSITORY" "$NEW_SHA" "$PR_NUMBER" <<'PY'
import json
import pathlib
import sys
import urllib.parse
import urllib.request

token_path, repo, sha, pr_number = sys.argv[1:]
token = pathlib.Path(token_path).read_text(encoding="utf-8").strip()
headers = {
    "Accept": "application/vnd.github+json",
    "Authorization": f"Bearer {token}",
    "User-Agent": "hermes-deals-release-auto-register",
    "X-GitHub-Api-Version": "2022-11-28",
}

def get(url: str):
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)

user = get("https://api.github.com/user")
if user.get("login") != "rozkalnsandris" or int(user.get("id") or 0) != 277435981:
    raise SystemExit("bridge token owner mismatch")
pr = get(f"https://api.github.com/repos/{repo}/pulls/{int(pr_number)}")
if not pr.get("merged") or pr.get("base", {}).get("ref") != "main":
    raise SystemExit("release source PR is not merged to main")
if pr.get("merge_commit_sha") != sha:
    raise SystemExit("release source PR SHA mismatch")
main = get(f"https://api.github.com/repos/{repo}/branches/main")
if main.get("commit", {}).get("sha") != sha:
    raise SystemExit("release SHA is not exact current main")
encoded = urllib.parse.quote(sha, safe="")
runs = get(
    f"https://api.github.com/repos/{repo}/actions/workflows/ci.yml/runs"
    f"?branch=main&head_sha={encoded}&status=completed&per_page=100"
).get("workflow_runs", [])
matches = [
    run for run in runs
    if run.get("event") == "push"
    and run.get("head_branch") == "main"
    and run.get("head_sha") == sha
    and run.get("conclusion") == "success"
]
if not matches:
    raise SystemExit("exact main SHA has no successful CI push run")
print(max(int(run["id"]) for run in matches))
PY
)"
[[ "$CI_RUN_ID" =~ ^[1-9][0-9]*$ ]] || fail "resolved CI run ID is invalid"

VERSION="$(python3 - "$SOURCE/backend/app/main.py" <<'PY'
import ast
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
versions = []
for node in ast.walk(tree):
    if not isinstance(node, ast.Call):
        continue
    name = node.func.id if isinstance(node.func, ast.Name) else getattr(node.func, "attr", "")
    if name != "FastAPI":
        continue
    for keyword in node.keywords:
        if keyword.arg == "version" and isinstance(keyword.value, ast.Constant):
            versions.append(keyword.value.value)
if len(versions) != 1 or not isinstance(versions[0], str):
    raise SystemExit("expected exactly one FastAPI version")
if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", versions[0]):
    raise SystemExit("FastAPI version is not numeric semver")
print(versions[0])
PY
)"
[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "release version derivation failed"

CURRENT_CONTAINER="$(docker compose \
  --project-directory "$PRIMARY" \
  --env-file "$PRIMARY/.env" \
  -f "$PRIMARY/docker-compose.yml" \
  -f "$PRIMARY/docker-compose.production.yml" \
  ps -q api)"
[[ -n "$CURRENT_CONTAINER" ]] || fail "production API container is not running"
CURRENT_TAG="$(docker inspect "$CURRENT_CONTAINER" --format '{{.Config.Image}}')"
CURRENT_IMAGE_ID="$(docker inspect "$CURRENT_CONTAINER" --format '{{.Image}}')"
[[ "$CURRENT_TAG" =~ ^hermes-deals-api:release-([0-9]+\.[0-9]+\.[0-9]+)-([0-9a-f]{7})$ ]] \
  || fail "current production image tag is not release-bound"
ROLLBACK_SHORT_SHA="${BASH_REMATCH[2]}"
ROLLBACK_SHA="$(runuser -u andris -- env HOME=/home/andris GIT_OPTIONAL_LOCKS=0 \
  git -C "$SOURCE" rev-parse "${ROLLBACK_SHORT_SHA}^{commit}")"
[[ "$ROLLBACK_SHA" =~ ^[0-9a-f]{40}$ && "${ROLLBACK_SHA:0:7}" == "$ROLLBACK_SHORT_SHA" ]] \
  || fail "rollback full SHA could not be resolved uniquely"
[[ "$(docker image inspect "$CURRENT_TAG" --format '{{.Id}}')" == "$CURRENT_IMAGE_ID" ]] \
  || fail "current image tag and container image ID disagree"
ROLLBACK_LABEL="$(docker image inspect "$CURRENT_TAG" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' 2>/dev/null || true)"
[[ -z "$ROLLBACK_LABEL" || "$ROLLBACK_LABEL" == "$ROLLBACK_SHA" ]] \
  || fail "current image revision label contradicts rollback SHA"

install -d -o root -g root -m 0750 /opt/backups/hermes-deals/releases
ROLLBACK_TMP="$(mktemp /opt/backups/hermes-deals/releases/.bridge-rollback.XXXXXX.tar.gz)"
cleanup() {
  [[ -z "$ROLLBACK_TMP" ]] || rm -f -- "$ROLLBACK_TMP"
}
trap cleanup EXIT
docker image save "$CURRENT_TAG" | gzip -n > "$ROLLBACK_TMP"
chown root:root "$ROLLBACK_TMP"
chmod 0600 "$ROLLBACK_TMP"
[[ -s "$ROLLBACK_TMP" ]] || fail "rollback archive is empty"

ARGS=(api-ui "$NEW_SHA" "$VERSION" "$ROLLBACK_SHA" "$CURRENT_TAG" "$ROLLBACK_TMP" "$SOURCE" "$CI_RUN_ID")
if [[ -n "$AUDIT_RUN_ID" ]]; then
  ARGS+=("$AUDIT_RUN_ID")
fi
"$REGISTER" "${ARGS[@]}"

printf 'AUTO_REGISTER_RESULT=PASS\nREGISTRY_STATUS=created\nCOMMIT_SHA=%s\nVERSION=%s\nROLLBACK_SHA=%s\nREQUIRED_CI_RUN_ID=%s\nREQUIRED_AUDIT_RUN_ID=%s\nDATABASE_WRITES_AUTHORIZED=false\n' \
  "$NEW_SHA" "$VERSION" "$ROLLBACK_SHA" "$CI_RUN_ID" "${AUDIT_RUN_ID:-none}"
