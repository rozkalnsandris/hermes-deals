  "never_implied": [
    "UNRELATED_ISSUE_OR_REPOSITORY_WORK",
    "RESET_REBASE_FORCE_OR_HISTORY_REWRITE",
    "PROVIDER_API_KEY",
    "TOKEN_BILLED_LLM_FALLBACK",
    "AUTOMATIC_PAID_CREDIT_PURCHASE"
  ],
  "merge": {
    "auto_run_full_command_is_explicit_owner_merge_authority_for_the_frozen_issue": true,
    "fresh_exact_head_revalidation_required": true,
    "required_ci_must_pass": true,
    "unresolved_actionable_review_findings_must_be_zero": true,
    "changed_head_requires_fresh_readiness_evidence": true,
    "force_merge": false
  },
  "live": {
    "auto_run_full_command_is_live_authority": false,
    "separate_explicit_owner_live_authorization_required": true,
    "existing_repository_live_contracts_remain_authoritative": true,
    "source_work_may_converge_before_live_gate": true,
    "state_when_definition_of_done_requires_unapproved_strict_live": "PAUSED_OWNER_LIVE_GATE",
    "new_live_mutation_class_after_activation": "STOP_SCOPE_OR_RISK",
    "post_live_mutation_error_without_predeclared_recovery": "STOP_ERROR"
  },
  "states": [
    "IDLE",
    "ACTIVATING",
    "WORKING",
    "WAITING_CI",
    "WAITING_REVIEW",
    "CORRECTING",
    "WAITING_SCHEDULED_RESUME",
    "PAUSED_USAGE",
    "PAUSED_PLATFORM_APPROVAL",
    "PAUSED_EXTERNAL",
    "PAUSED_OWNER_LIVE_GATE",
    "VERIFYING",
    "DONE",
    "STOP_SCOPE_OR_RISK",
    "STOP_ERROR"
  ],
  "continuation": {
    "routine_ci_failure_is_owner_gate": false,
    "review_finding_is_owner_gate": false,
    "ordinary_merge_conflict_is_owner_gate": false,
    "session_or_turn_end_is_owner_gate": false,
    "scheduled_run_reconstructs_from_github": true,
    "usage_exhaustion": "PAUSED_USAGE",
    "platform_required_app_approval": "PAUSED_PLATFORM_APPROVAL",
    "external_wait": "PAUSED_EXTERNAL",
    "identical_failure_retry_ceiling": 3,
    "retry_requires_materially_new_hypothesis_after_repeat": true
  },
  "completion": {
    "source_only_normal_terminal_state": "DONE",
    "target_issue_definition_of_done_must_be_satisfied": true,
    "final_github_receipt_required": true,
    "controller_returns_to_idle_on_done": true,
    "strict_live_required_but_not_authorized_is_not_done": true
  },
  "billing": {
    "primary_product": "CHATGPT_PLUS",
    "provider_api_keys_allowed": false,
    "automatic_paid_credits_allowed": false,
    "codex_required": false,
    "copilot_required": false
  },
  "platform_constraints": {
