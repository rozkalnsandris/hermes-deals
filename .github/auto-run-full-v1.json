{
  "schema_version": 3,
  "policy": "AUTO-RUN FULL v1",
  "repository": "rozkalnsandris/hermes-deals",
  "enablement_issue": 815,
  "controller_issue": 814,
  "command": {
    "canonical_prefix": "AUTO-RUN FULL",
    "syntax": "AUTO-RUN FULL hermes-deals #<issue>",
    "requires_explicit_current_command": true,
    "requires_exact_repository": true,
    "requires_exact_open_issue": true,
    "may_be_inferred_from_context": false,
    "single_command_is_owner_source_and_merge_authorization": true,
    "single_command_is_live_authorization": false
  },
  "execution_model": {
    "canonical_state": "GITHUB",
    "one_active_issue_at_a_time": true,
    "chat_history_is_authority": false,
    "scheduled_controller": "CHATGPT_PLUS_SCHEDULED_TASK",
    "minimum_background_recurrence": "PT1H",
    "session_end_is_resumable": true,
    "manual_turpini_is_resume_only": true
  },
  "activation": {
    "fresh_reads_required": [
      "AGENTS.md",
      ".github/start-mode-routing.json",
      ".github/auto-run-full-v1.json",
      "target_issue",
      "current_main",
      "active_pr_ci_review_state",
      "relevant_dependencies",
      "controller_issue_814"
    ],
    "preferred_write_order": [
      "AUTHORIZATION_RECEIPT",
      "POST_RECEIPT_MAIN_REVALIDATION",
      "CONTROLLER_ACTIVATION",
      "SOURCE_WORK"
    ],
    "materialize_owner_auth_on_target_issue": true,
    "activation_comment_schema": "rozkalns.auto-run-full-authorization.v1",
    "activation_must_freeze": [
      "repository",
      "issue_number",
      "issue_definition_of_done",
      "allowed_source_actions",
      "merge_authority",
      "retry_semantics",
      "explicit_exclusions"
    ],
    "authorization_receipt_required_before": [
      "CONTROLLER_ACTIVE_POINTER_WRITE",
      "BRANCH_CREATE",
      "SOURCE_FILE_WRITE",
      "COMMIT_OR_PUSH",
      "PR_CREATE_OR_UPDATE",
      "MERGE",
      "RUNTIME_OR_LIVE_MUTATION"
    ],
    "stable_receipt_required_before": [
      "CONTROLLER_WORKING_POINTER_WRITE",
      "BRANCH_CREATE",
      "SOURCE_FILE_WRITE",
      "COMMIT_OR_PUSH",
      "PR_CREATE_OR_UPDATE",
      "MERGE",
      "RUNTIME_OR_LIVE_MUTATION"
    ],
    "post_receipt_main_revalidation_required": true,
    "post_receipt_main_stability": {
      "barrier": "READ_MAIN_M0__WRITE_RECEIPT_M0__READ_MAIN_M1__REQUIRE_M1_EQUALS_M0",
      "stable_when": "POST_WRITE_MAIN_SHA_EQUALS_RECEIPT_ACTIVATION_MAIN_SHA",
      "only_latest_stable_receipt_is_authoritative_for_source_and_merge": true,
      "stale_receipt_never_authorizes_source_or_merge": true,
      "main_only_drift_consumes_owner_authorization": false,
      "main_only_drift_requires_new_owner_command": false,
      "max_consecutive_inline_stabilization_attempts": 3,
      "after_attempt_limit_state": "PAUSED_EXTERNAL",
      "paused_controller_pointer_allowed_after_receipt": true,
      "paused_controller_pointer_is_source_authority": false,
      "scheduled_resume_must_establish_stable_receipt_before_source": true,
      "scope_or_rule_drift_is_not_main_only_drift": true
    },
    "main_drift_before_source_recovery": {
      "allowed": true,
      "requires_no_branch_source_commit_pr_merge_runtime_or_live_mutation": true,
      "requires_fresh_revalidation": [
        "exact_target_issue_is_still_open",
        "target_issue_scope_is_identical_to_frozen_scope",
        "repository_rules_and_policy_are_compatible_with_frozen_scope",
        "controller_points_to_no_other_issue",
        "no_branch_source_commit_pr_merge_runtime_or_live_mutation_occurred",
        "current_main_active_pr_ci_review_and_dependencies_are_freshly_re_read"
      ],
      "old_receipt_is_immutable_audit_record": true,
      "old_receipt_must_not_be_deleted_or_edited": true,
      "superseding_receipt_required": true,
      "superseding_receipt_fields": [
        "supersedes_comment_id",
        "supersession_reason",
        "activation_main_sha"
      ],
      "supersession_reason": "MAIN_DRIFT_BEFORE_SOURCE",
      "superseding_receipt_must_preserve_frozen_scope": true,
      "new_explicit_command_may_supersede_prior_stopped_stale_receipt": true,
      "prior_stopped_receipt_recovery_requires_controller_idle_or_same_issue_paused_external": true,
      "prior_stopped_receipt_recovery_requires_no_source_or_live_mutation": true,
      "latest_superseding_receipt_must_pass_post_write_main_revalidation": true,
      "mismatch_after_prohibited_mutation_requires_stop": true
    },
    "classification_metadata_write_before_receipt_is_optional": true,
    "pre_receipt_metadata_recovery": {
      "allowed": true,
      "allowed_write_class": "IDEMPOTENT_SAME_TARGET_ISSUE_METADATA_ONLY",
      "example": "ADD_CLASSIFICATION_LABEL",
      "does_not_consume_owner_authorization": true,
      "does_not_count_as_source_mutation": true,
      "does_not_count_as_live_mutation": true,
      "requires_fresh_revalidation": [
        "controller_is_IDLE_with_null_active_issue",
        "exact_target_issue_is_still_open",
        "target_issue_scope_has_not_widened",
        "no_branch_source_commit_pr_merge_controller_active_runtime_or_live_mutation_occurred",
        "current_main_and_repository_rules_are_freshly_re_read"
      ],
      "receipt_must_be_persisted_before_any_non_metadata_mutation": true
    },
    "pre_receipt_non_metadata_mutation_requires_stop": true,
    "later_issue_edits_do_not_expand_authority": true,
    "new_scope_requires_stop": true
  },
  "allowed_without_further_owner_nudge": [
    "FRESH_GITHUB_READS",
    "SOURCE_ANALYSIS",
    "SOURCE_DOC_TEST_POLICY_CHANGES",
    "BRANCH_CREATE",
    "EXACT_PATH_COMMITS",
    "PUSH",
    "PR_CREATE_OR_UPDATE",
    "CI_WAIT_AND_INSPECTION",
    "REVIEW_INGESTION",
    "SCOPE_PRESERVING_CORRECTIVE_COMMITS",
    "MERGE_CONFLICT_RESOLUTION_WITHOUT_HISTORY_REWRITE",
    "MERGE_WHEN_EXACT_HEAD_AND_REQUIRED_CHECKS_SATISFY_FROZEN_AUTHORIZATION",
    "POST_MERGE_READ_ONLY_REVALIDATION",
    "FINAL_GITHUB_RECEIPTS"
  ],
  "strict_live_never_implied": [
    "PRODUCTION_DEPLOY",
    "PRODUCTION_DATABASE_WRITE_OR_MIGRATION",
    "REVIEW_OR_PUBLICATION_WRITE",
    "RETAINED_OR_SOURCE_EVIDENCE_MUTATION",
    "RUNTIME_REPLAY_APPLY_OR_EXECUTOR_INVOCATION",
    "LIVE_COLLECTOR_OR_SOURCE_EXECUTION_WITH_WRITE_EFFECTS",
